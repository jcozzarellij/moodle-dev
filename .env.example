# =====================================================================
#  moodle-dev-template - configuración de la instancia
#  Copia este archivo a .env y ajusta lo que necesites.
# =====================================================================

# Nombre de la instancia. Cambiarlo permite levantar VARIAS instancias en
# paralelo: cada una tiene sus propios contenedores y volúmenes (datos).
COMPOSE_PROJECT_NAME=moodle45

# Puerto en tu máquina: http://localhost:8080
MOODLE_PORT=8080
# URL pública. Por defecto http://localhost:<MOODLE_PORT>. Debe coincidir
# exactamente con la URL del navegador.
# MOODLE_WWWROOT=http://localhost:8080
# Pon 1 si accedes por HTTPS detrás de un proxy (ngrok, traefik...).
MOODLE_SSLPROXY=0

# --- Versiones (cambiar requiere: docker compose up -d --build) ---------
MOODLE_VERSION=v4.5.16
PHP_VERSION=8.3
POSTGRES_VERSION=17
# Idiomas incluidos en la imagen (separados por espacios), p. ej. "es pt_br".
MOODLE_LANGS=es

# --- Sitio y administrador (solo se aplican en la PRIMERA instalación) ---
MOODLE_SITE_NAME="Moodle Dev - Programación"
MOODLE_SITE_SHORTNAME=moodledev
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS="Admin#2026"
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_LANG=es
MOODLE_TIMEZONE=America/Guayaquil

# Token fijo para el usuario de servicios web (32 caracteres hex).
# Vacío = se usa el token de ejemplo documentado en USUARIOS.md.
MOODLE_WS_TOKEN=

# --- Desarrollo ---------------------------------------------------------
# 1 = depuración DEVELOPER + sin caché de JS/plantillas/tema. 0 = normal.
MOODLE_DEBUG=1

# --- Base de datos ------------------------------------------------------
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=moodle

# --- PHP ----------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_POST_MAX_SIZE=128M

# --- Correo (opcional). Vacío = Moodle no envía ningún correo. -----------
MOODLE_SMTP_HOST=
MOODLE_SMTP_USER=
MOODLE_SMTP_PASS=
# "", "ssl" o "tls"
MOODLE_SMTP_SECURE=
MOODLE_NOREPLY_ADDRESS=noreply@example.com
